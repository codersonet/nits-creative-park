# Docker Compose settings
POSTGRES_USER=creativepark
POSTGRES_DB=creativepark
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# Backend settings passed through Docker Compose
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MINUTE=300
CONTACT_RATE_LIMIT_PER_HOUR=5
CONTACT_RETENTION_DAYS=365

# Frontend build settings passed through Docker Compose
VITE_SITE_URL=http://localhost:8080
VITE_BASE_PATH=/
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK_DATA=false
