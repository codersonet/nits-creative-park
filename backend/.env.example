NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgres://creativepark:change-me-postgres@localhost:5432/creativepark
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_SSL=false

REDIS_URL=redis://:change-me-redis@localhost:6379
CACHE_TTL_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=300
CONTACT_RATE_LIMIT_PER_HOUR=5
CONTACT_RETENTION_DAYS=365
ALLOW_SEED=false

# Set this only when running integration tests against a real database.
# TEST_DATABASE_URL=postgres://creativepark:change-me-postgres@localhost:5432/creativepark_test
